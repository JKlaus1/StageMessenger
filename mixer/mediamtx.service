# Stage Messenger low-latency listen-back (v2.0): MediaMTX relays the WING feed to browsers over WebRTC.
# Install (from ~/stage-messenger):
#   sudo cp mixer/mediamtx.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now mediamtx
# The binary lives in ~/mediamtx (downloaded once); the config is tracked in git and reloads itself on change.
[Unit]
Description=MediaMTX (Stage Messenger WebRTC listen-back)
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/mediamtx
ExecStart=/home/pi/mediamtx/mediamtx /home/pi/stage-messenger/mixer/mediamtx.yml
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
