# Stage Messenger v2.4 -- passwordless control of go-librespot for the /mixer kill switch.
#
# The Pi playback card's "Restart" and "Sign out & re-pair" run (as pi, no TTY):
#     sudo -n /usr/bin/systemctl restart|stop|start go-librespot.service
# Without this drop-in those calls need a password and fail. (The plain "Disconnect" button uses
# go-librespot's own API and needs nothing.)
#
# This grants ONLY those three commands for that one unit, nothing else.
# Installed by mixer/setup_spotify.sh (validated with visudo first):
#     install -m 0440 -o root -g root mixer/stage-messenger-spotify.sudoers /etc/sudoers.d/stage-messenger-spotify
# The deployed filename must have NO dot in it (files with a "." in /etc/sudoers.d are ignored).
# Debian Trixie: command -v systemctl -> /usr/bin/systemctl (matches mixer/spotify.py SYSTEMCTL).

pi ALL=(root) NOPASSWD: /usr/bin/systemctl restart go-librespot.service, /usr/bin/systemctl stop go-librespot.service, /usr/bin/systemctl start go-librespot.service
