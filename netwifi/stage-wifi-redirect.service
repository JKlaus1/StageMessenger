# Port-80 front door: http://<hostname>.local/ -> :3000/wifi (venue WiFi page), other paths -> :3000.
# Installed by netwifi/install_netwifi.sh to /etc/systemd/system/stage-wifi-redirect.service
[Unit]
Description=Stage Messenger port-80 redirect (hostname.local -> WiFi page)
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /usr/local/lib/stage-messenger/redirect80.py
Environment=TARGET_PORT=3000 LANDING=/wifi
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
